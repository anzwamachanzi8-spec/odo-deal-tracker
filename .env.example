# Copy this file to .env and fill in real values. .env is git-ignored: never commit it.

# ntfy.sh topic: pick something long and random, e.g. odo-deals-k3j9x2q8. Anyone who knows
# it can read (and send) your pushes, which is why it lives here and not in config.toml.
NTFY_TOPIC=

# Gmail address and a Gmail *app password* (not your normal password). See README.
SMTP_USER=
SMTP_PASSWORD=

# Optional WhatsApp via Twilio (only used if [notifications.whatsapp] enabled = true)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
